# ==============================================================================
# SpeedGo 服务端配置文件 (.env)
# 复制此文件为 .env 并在本地或服务器上修改：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础网络监听配置
# ------------------------------------------------------------------------------
# HTTP 服务监听端口 (默认: 8080)
SPEEDGO_PORT=8080

# 服务的公网基础访问地址 (如: https://speed.example.com)
# CLI 测速脚本将优先以此地址为基准，留空则根据请求 Host 动态识别
SPEEDGO_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 2. 网络安全与反向代理信任
# ------------------------------------------------------------------------------
# 反向代理标头信任开关 (默认: false)
# - false: 公网独立暴露模式，强制使用真实的底层连接 IP，严格忽略客户端伪造的代理标头
# - true : 反代模式，当服务置于 Nginx/Caddy/Cloudflare 等受信任反向代理之后时开启，
#          程序将依次从 CF-Connecting-IP, X-Real-IP, X-Forwarded-For 提取用户真实公网 IP
SPEEDGO_TRUST_PROXY=false

# 跨域资源共享 CORS 标头开关 (默认: true)
SPEEDGO_CORS=true

# ------------------------------------------------------------------------------
# 3. 存储与数据库配置
# ------------------------------------------------------------------------------
# SQLite 数据库持久化路径 (默认: ./data/speedgo.db)
# 生产环境使用 Docker 时建议挂载宿主机目录: ./data:/data
SPEEDGO_DB=./data/speedgo.db

# 历史记录保留天数 (默认: 0)
# 自动删除超过该天数的测速记录；设为 0 表示不按时间清理
SPEEDGO_HISTORY_MAX_DAYS=0

# 历史记录保留条数上限 (默认: 10000)
# 仅保留最近 N 条测速记录，超出的旧记录将被删除；设为 0 表示不限制条数
SPEEDGO_HISTORY_MAX_RECORDS=10000

# ------------------------------------------------------------------------------
# 4. 离线 GeoIP 与 ASN 识别库
# ------------------------------------------------------------------------------
# MaxMind GeoLite2-City.mmdb 离线库文件路径
SPEEDGO_GEO_CITY=./data/GeoLite2-City.mmdb

# MaxMind GeoLite2-ASN.mmdb 离线库文件路径
SPEEDGO_GEO_ASN=./data/GeoLite2-ASN.mmdb

# ------------------------------------------------------------------------------
# 5. 流量引擎与安全阈值控制
# ------------------------------------------------------------------------------
# 单次测速阶段（上传/下载/Ping）最大保护超时时间（秒，默认: 30）
# 用于切断过慢的慢速连接 (Slowloris)
SPEEDGO_MAX_TIME=30

# 单次下载分块最大安全容量上限（MB，默认: 512）
SPEEDGO_MAX_CHUNK=512

# 前端静态资源目录 (若使用内置静态资源则留空即可)
# SPEEDGO_STATIC_DIR=./web/dist
